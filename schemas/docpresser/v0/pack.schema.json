{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.3leaps.dev/docpresser/v0/pack.schema.json",
  "title": "Docpresser Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "state",
    "pack_kind",
    "format_family",
    "tier",
    "schema_sha256",
    "case_count",
    "total_input_bytes",
    "files"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "docpresser/v0"
    },
    "state": {
      "type": "string",
      "enum": [
        "complete"
      ]
    },
    "pack_kind": {
      "type": "string",
      "enum": [
        "structcorpus",
        "synthetic"
      ]
    },
    "format_family": {
      "type": "string",
      "enum": [
        "yaml",
        "json",
        "xml",
        "xhtml",
        "svg",
        "ooxml",
        "pdf",
        "mixed"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "smoke",
        "conformance",
        "stress",
        "migration",
        "workload"
      ]
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "scale": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "corpus_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "corpus_profile": {
      "type": "string",
      "minLength": 1
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case_count": {
      "type": "integer",
      "minimum": 1
    },
    "total_input_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "records"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}

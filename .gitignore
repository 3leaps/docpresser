**/.claude/settings.local.json

# goneat local overrides
.goneat/tools.local.yaml

# Backstop only. Local instructions belong outside the repository tree.
# A gitignore entry is a convenience filter, not a security boundary.
AGENTS.local.md
AGENTS.*.local.md

# Temporary files
tmp/
temp/
*.tmp

# Logs
*.log
logs/

# Python / Rust / Node driver build caches
__pycache__/
*.pyc
drivers/*/target/
drivers/*/node_modules/
